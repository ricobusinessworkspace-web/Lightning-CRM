{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth/metadata?doc=resource" },
    { "source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/oauth/metadata?doc=resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth/metadata?doc=server" },
    { "source": "/.well-known/oauth-authorization-server/api/mcp", "destination": "/api/oauth/metadata?doc=server" }
  ]
}
